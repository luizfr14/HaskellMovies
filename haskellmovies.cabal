cabal-version:      3.0
name:               haskellmovies
version:            0.1.0.0
synopsis:           Rede social de filmes (trabalho de Haskell - Fatec)
build-type:         Simple

common avisos
    ghc-options: -Wall

executable haskellmovies
    import:           avisos
    -- Warp precisa do runtime com várias threads (uma por requisição)
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    main-is:          Main.hs
    hs-source-dirs:   app
    other-modules:    Api
                    , Banco
                    , Config
                    , Dados.Usuarios
                    , Erro
                    , Handlers
                    , Handlers.Conta
                    , Regras
                    , Sessao
                    , Tipos
                    , Util
    build-depends:    base >=4 && <5
                    , aeson
                    , bcrypt
                    , bytestring
                    , directory
                    , entropy
                    , postgresql-simple
                    , resource-pool >=0.4
                    , servant
                    , servant-server
                    , text
                    , warp
    default-language: Haskell2010
