# Copie este arquivo para ".env" e preencha os valores.
# O ".env" NÃO vai para o Git (está no .gitignore).

# Conexão com o PostgreSQL (Supabase > Project Settings > Database > Connection string)
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Token de leitura da API do TMDB (themoviedb.org > Configurações > API > "API Read Access Token")
TMDB_TOKEN=
