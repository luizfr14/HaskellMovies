# Copie este arquivo para ".env" e preencha os valores.
# O ".env" NÃO vai para o Git (está no .gitignore).

# Conexão com o PostgreSQL (Supabase > Project Settings > Database > Connection string)
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Token de leitura da API do TMDB (themoviedb.org > Configurações > API > "API Read Access Token")
TMDB_TOKEN=

# Troca de foto de perfil (Supabase Storage). Opcional: sem estas duas, o sistema funciona
# normalmente, só não deixa trocar a foto.
# SUPABASE_URL: Project Settings > API > Project URL
# SUPABASE_SERVICE_KEY: Project Settings > API Keys > "secret" (service_role). É SECRETA: só no .env!
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=
